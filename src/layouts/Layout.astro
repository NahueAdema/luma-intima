---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Luma Íntima - Tienda de lencería femenina y sexshop. Lencería elegante, moderna y sofisticada." />
		<title>Luma Íntima - Lencería & Sexshop</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Dancing+Script:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
	</head>
	<body>
		<slot />
		<script>
			lucide.createIcons();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-mint-primary: #AFDAC6;
		--color-mint-light: #DFF0E8;
		--color-sage-soft: #C0E5D4;
		--color-warm-white: #FAFAF7;
		--color-soft-black: #171A18;
		--color-neutral-gray: #777D79;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'Montserrat', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
			'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
			sans-serif;
		background-color: var(--color-warm-white);
		color: var(--color-soft-black);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	button {
		font-family: inherit;
		cursor: pointer;
		border: none;
		background: none;
	}

	ul {
		list-style: none;
	}
</style>
