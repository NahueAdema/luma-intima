---
import Layout from '../layouts/Layout.astro';
import InfoBar from './InfoBar.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  category?: string;
  collection?: 'all' | 'new' | 'best' | 'sale' | 'favorites';
}

const { title, subtitle, description, category = 'todos', collection = 'all' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const categories = [
  ['todos', 'Todo el catálogo'], ['conjuntos', 'Conjuntos'], ['bombachas', 'Bombachas'],
  ['bodys', 'Bodys'], ['ropa-deportiva', 'Deportivo'], ['sexshop', 'Intimates'],
  ['medias', 'Medias'], ['boxers', 'Boxers'], ['promociones', 'Promociones'],
];
const links = [
  ['/tienda', 'Colección completa'], ['/tienda/novedades', 'Recién llegados'],
    ['/tienda/mas-vendidos', 'Más elegidos'], ['/tienda/promociones', 'Últimas oportunidades'], ['/tienda/favoritos', 'Mis favoritos'],
];
---

<Layout title={`${title} | Luma Íntima`} description={description}>
  <InfoBar />
  <Header />
  <main class="collection-page" data-collection={collection} data-default-category={category} data-main-catalog={String(currentPath === '/tienda')}>
    <section class="collection-hero">
      <div class="collection-hero-copy">
        <p class="collection-kicker">LUMA ÍNTIMA <span>·</span> COLECCIÓN</p>
        <h1>{title}</h1>
        <p class="collection-subtitle">{subtitle}</p>
        <div class="collection-breadcrumb"><a href="/">Inicio</a><span>/</span><a href="/tienda">Tienda</a><span>/</span><b>{title}</b></div>
      </div>
      <div class="collection-hero-note"><span class="note-flower">✳</span><p>{description}</p><span class="note-label">PENSADA PARA SENTIRTE VOS</span></div>
    </section>

    {currentPath === '/tienda' && <section class="luma-signature"><span class="signature-index">L / 01</span><span class="signature-rule"></span><p>Vestite de la sensación de <em>estar en tu piel.</em></p><a href="/nosotras/">El ritual Luma <b>↗</b></a></section>}

    <nav class="collection-shortcuts" aria-label="Explorar colecciones">
      {links.map(([href, label]) => <a href={`${href}/`} class:list={{ selected: href === currentPath }}>{label}<span>↗</span></a>)}
    </nav>

    <section class="shop-controls" aria-label="Filtrar catálogo">
      <div class="shop-filters">
        {categories.map(([slug, label]) => <button class="shop-filter" data-category={slug} aria-pressed={slug === category ? 'true' : 'false'}>{label}</button>)}
      </div>
      <div class="shop-toolbar">
        <p id="productos-count" aria-live="polite">Cargando colección…</p>
        <div class="toolbar-actions">
          <label class="catalog-search"><span>⌕</span><input id="catalog-search" type="search" placeholder="Buscar una prenda" aria-label="Buscar productos" /></label>
          <label class="sort-control"><span>Ordenar</span><select id="catalog-sort" aria-label="Ordenar productos"><option value="recent">Novedades</option><option value="price-up">Precio: menor a mayor</option><option value="price-down">Precio: mayor a menor</option><option value="name">Nombre</option></select></label>
        </div>
      </div>
    </section>

    <section class="catalog-content" aria-label="Productos">
      <p id="catalog-notice" class="catalog-notice" hidden>Estás viendo una colección de muestra. Conectá Supabase para publicar el inventario de tu tienda.</p>
      <div id="productos-grid" class="catalog-grid"><div class="catalog-empty">Preparando la colección…</div></div>
      <dialog id="product-dialog" class="product-dialog"><button class="dialog-close" aria-label="Cerrar detalle">×</button><div id="product-dialog-content"></div></dialog>
    </section>
    <section class="care-note"><span>✳</span><p><b>Un detalle para vos.</b> Cada prenda está elegida para acompañarte con comodidad, suavidad y ese toque especial que cambia el día.</p><a href="/nosotras">Conocé Luma ↗</a></section>
  </main>
  <Footer />
</Layout>

<script>import '../scripts/catalog.ts';</script>

<style is:global>
  .collection-page{--ink:#171a18;--mint:#afdac6;--mint-pale:#eaf4ee;--paper:#fafaf7;--muted:#777d79;color:var(--ink);background:var(--paper)}
  .collection-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 300px;align-items:center;gap:4rem;max-width:1400px;margin:auto;padding:76px 40px 58px;overflow:hidden}
  .collection-hero:before{content:"";position:absolute;inset:0 0 0 44%;background:radial-gradient(ellipse at 80% 35%,#dff0e8 0,transparent 55%),linear-gradient(115deg,transparent,#f0f6f1 75%);z-index:0;pointer-events:none}
  .collection-hero-copy,.collection-hero-note{position:relative;z-index:1}.collection-kicker,.note-label{font-size:9px;letter-spacing:.22em;font-weight:600;color:#64816d}.collection-kicker span{padding:0 6px;color:#9db6a4}.collection-hero h1{font-size:clamp(44px,6vw,76px);font-weight:300;letter-spacing:-.055em;line-height:1.02;margin:22px 0 14px}.collection-subtitle{font-family:'Dancing Script',cursive;font-size:28px;color:#688672;margin:0}.collection-breadcrumb{display:flex;gap:10px;align-items:center;margin-top:27px;font-size:10px;color:#858e88}.collection-breadcrumb b{font-weight:500;color:var(--ink)}.collection-hero-note{max-width:270px;border-left:1px solid #9ebda8;padding:7px 0 7px 24px}.note-flower{font-size:22px;color:#72917c}.collection-hero-note p{font-size:13px;line-height:1.9;color:#59645c;margin:12px 0 17px}.note-label{font-size:8px}
  .collection-hero h1{font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(56px,7vw,92px);font-weight:400;letter-spacing:-.035em}.collection-page[data-main-catalog=true] .collection-hero{padding-top:88px;padding-bottom:72px}.collection-page[data-main-catalog=true] .collection-hero:before{inset:0 0 0 34%;background:radial-gradient(ellipse at 77% 34%,#dceee1 0,transparent 57%),linear-gradient(110deg,transparent,#f0f6f1 78%)}
  .luma-signature{max-width:1400px;margin:0 auto;padding:21px 40px;display:flex;align-items:center;gap:20px;background:#eaf2eb;border-top:1px solid #dfe9e1;border-bottom:1px solid #dfe9e1}.signature-index{white-space:nowrap;color:#73917a;font:500 13px 'Cormorant Garamond',serif;letter-spacing:.09em}.signature-rule{width:1px;height:32px;background:#b9cdbd}.luma-signature p{flex:1;margin:0;color:#516256;font:400 23px 'Cormorant Garamond',serif}.luma-signature p em{color:#77927c}.luma-signature a{white-space:nowrap;color:#49654f;font-size:8px;letter-spacing:.13em;text-transform:uppercase}.luma-signature a b{padding-left:8px;font-size:13px;font-weight:400}
  .collection-shortcuts{display:flex;justify-content:center;gap:clamp(12px,2vw,28px);padding:16px 20px;border-top:1px solid #e8eeea;border-bottom:1px solid #e8eeea;background:#fff;overflow-x:auto}.collection-shortcuts a{white-space:nowrap;padding:11px 16px;border:1px solid transparent;font-size:9px;letter-spacing:.08em;color:#58645c;transition:color .2s,border-color .2s,background .2s}.collection-shortcuts a span{margin-left:9px;color:#87a591}.collection-shortcuts a:hover,.collection-shortcuts a.selected{color:#45674d;border-color:#dce9de;background:#f5f9f5}
  .shop-controls{max-width:1400px;margin:auto;padding:30px 40px 0}.shop-filters{display:flex;gap:8px;overflow-x:auto;padding:3px 0 20px;scrollbar-width:thin}.shop-filter{flex:none;border:1px solid #dfe7e1;border-radius:99px;background:transparent;color:#5f6962;padding:9px 15px;font:9px 'Montserrat',sans-serif;letter-spacing:.06em;transition:all .2s}.shop-filter:hover,.shop-filter[aria-pressed=true]{background:#171a18;color:white;border-color:#171a18}.shop-toolbar{border-top:1px solid #e8eeea;padding:19px 0;display:flex;align-items:center;justify-content:space-between;gap:16px}.shop-toolbar>p{font-size:11px;color:#737d76;margin:0}.toolbar-actions{display:flex;align-items:center;gap:18px}.catalog-search{display:flex;align-items:center;gap:8px;border-bottom:1px solid #cdd8d0;padding:3px 0}.catalog-search span{font-size:22px;color:#64816d}.catalog-search input{width:170px;border:0;background:transparent;font:10px 'Montserrat',sans-serif;outline:0;color:var(--ink)}.sort-control{display:flex;align-items:center;gap:8px;font-size:9px;color:#777d79}.sort-control select{border:0;background:transparent;font:10px 'Montserrat',sans-serif;color:var(--ink);padding:5px}
  .catalog-content{max-width:1400px;margin:auto;padding:5px 40px 64px}.catalog-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:38px 22px}.catalog-empty{grid-column:1/-1;padding:100px 20px;text-align:center;color:#777d79;font-size:13px}.catalog-card{min-width:0;animation:catalog-enter .4s ease both}.catalog-media{position:relative;aspect-ratio:4/5;overflow:hidden;background:#edf2ee}.catalog-media img{width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.2,.65,.3,1)}.catalog-card:hover .catalog-media img{transform:scale(1.045)}.catalog-badges{position:absolute;left:12px;top:12px;display:grid;gap:5px}.catalog-badge{padding:6px 9px;background:#e3f0e8;color:#354a3b;font-size:8px;letter-spacing:.1em;text-transform:uppercase}.catalog-badge.dark{background:#171a18;color:#fff}.catalog-fav{position:absolute;right:12px;top:12px;width:34px;height:34px;border-radius:50%;background:#ffffffdf;color:#354a3b;font-size:19px;line-height:1}.catalog-fav[aria-pressed=true]{color:#a25e70}.catalog-view{position:absolute;left:12px;right:12px;bottom:12px;padding:12px;background:#fffffff0;color:#171a18;text-align:center;font-size:9px;letter-spacing:.12em;text-transform:uppercase;opacity:0;transform:translateY(6px);transition:.22s}.catalog-card:hover .catalog-view,.catalog-view:focus-visible{opacity:1;transform:none}.catalog-info{padding:14px 2px 0}.catalog-category{font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:#89938c;margin:0 0 6px}.catalog-title{font-size:13px;line-height:1.5;font-weight:400;margin:0 0 8px}.catalog-price{display:flex;gap:9px;align-items:center;font-size:12px;font-weight:500}.catalog-old-price{color:#929992;text-decoration:line-through;font-size:10px;font-weight:400}.catalog-meta{margin:8px 0 0;color:#89918b;font-size:9px}.product-dialog{position:fixed;inset:50% auto auto 50%;transform:translate(-50%,-50%);margin:0;width:min(880px,calc(100% - 40px));max-width:none;max-height:calc(100dvh - 40px);overflow:auto;border:1px solid #e4ebe4;padding:0;background:#fafaf7;color:#171a18;box-shadow:0 30px 100px #0004}.product-dialog[open]{display:block}.product-dialog::backdrop{background:#17221ccc;backdrop-filter:blur(5px)}.dialog-close{position:absolute;top:15px;right:15px;z-index:2;width:38px;height:38px;border-radius:50%;background:#fffffff0;border:1px solid #e5ebe5;font-size:25px;color:#37463b;display:grid;place-items:center}.dialog-product{display:grid;grid-template-columns:1.02fr .98fr;min-height:500px}.dialog-product img{width:100%;height:100%;min-height:500px;object-fit:cover}.dialog-copy{padding:58px 44px;align-self:center}.dialog-copy .catalog-title{font:400 36px/1.08 'Cormorant Garamond',Georgia,serif;letter-spacing:-.015em}.dialog-copy .catalog-description{font-size:12px;line-height:1.9;color:#69736c;margin:22px 0}.dialog-copy .catalog-meta{margin-top:14px}.dialog-close:focus-visible,.catalog-fav:focus-visible,.shop-filter:focus-visible{outline:2px solid #70927b;outline-offset:3px}
  .catalog-notice{margin:0 0 22px;padding:12px 15px;background:#edf5ef;color:#536c59;font-size:10px;letter-spacing:.04em}
  .shop-filter,.catalog-fav,.catalog-view,.dialog-close{font-family:'Montserrat',sans-serif;cursor:pointer}.shop-filter{min-height:38px;padding:9px 17px;background:#fff}.shop-filter:hover{transform:translateY(-1px);box-shadow:0 5px 14px #1b32220d}.shop-filter[aria-pressed=true]{box-shadow:0 4px 12px #1b32221c}.catalog-view{border:1px solid #e5ebe5;box-shadow:0 5px 20px #1a2b1c12}.catalog-view:hover{background:#edf5ef}.dialog-close{width:34px;height:34px;border:1px solid #dfe8e0;border-radius:50%;background:#ffffffd9;line-height:1}.catalog-fav:hover{transform:scale(1.06);box-shadow:0 5px 14px #1b322220}
  .care-note{max-width:1320px;margin:0 auto 75px;padding:24px 30px;display:flex;align-items:center;gap:16px;background:#edf5ef}.care-note>span{font-size:23px;color:#73917c}.care-note p{flex:1;font-size:11px;line-height:1.8;color:#5b665e;margin:0}.care-note p b{color:#27352b}.care-note a{white-space:nowrap;font-size:9px;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid #8eaa96;padding-bottom:4px}
  @keyframes catalog-enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  @media(max-width:1000px){.collection-hero{padding:62px 26px;grid-template-columns:1fr 230px;gap:30px}.shop-controls{padding-left:26px;padding-right:26px}.catalog-content{padding-left:26px;padding-right:26px}.catalog-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 16px}}
  @media(max-width:680px){.collection-hero{grid-template-columns:1fr;padding:48px 20px 36px;gap:25px}.collection-hero:before{inset:0 0 0 10%}.collection-hero h1{font-size:52px}.collection-subtitle{font-size:24px}.collection-hero-note{max-width:none;margin-left:8px;padding-left:17px}.collection-hero-note p{margin:7px 0}.collection-shortcuts{justify-content:flex-start;padding-left:20px;gap:10px}.luma-signature{padding:16px 20px;gap:12px}.signature-index{font-size:11px}.signature-rule{height:28px}.luma-signature p{font-size:19px}.luma-signature a{font-size:7px}.shop-controls{padding:20px 16px 0}.shop-filters{margin-right:-16px;padding-right:16px}.shop-toolbar{align-items:flex-start;flex-direction:column}.toolbar-actions{width:100%;justify-content:space-between;gap:6px}.catalog-search input{width:min(36vw,170px)}.sort-control{gap:3px}.sort-control select{max-width:125px}.catalog-content{padding:0 16px 40px}.catalog-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 12px}.catalog-info{padding-top:10px}.catalog-title{font-size:11px}.catalog-price{font-size:11px}.catalog-view{opacity:1;transform:none;left:7px;right:7px;bottom:7px;padding:10px 4px;font-size:8px}.catalog-badges{left:7px;top:7px}.catalog-badge{font-size:7px;padding:5px 6px}.catalog-fav{right:7px;top:7px;width:30px;height:30px}.care-note{margin:0 16px 45px;padding:18px;align-items:flex-start;flex-wrap:wrap}.care-note p{flex-basis:calc(100% - 45px)}.care-note a{margin-left:39px}.product-dialog{width:calc(100% - 22px);max-height:calc(100dvh - 22px)}.dialog-product{grid-template-columns:1fr;min-height:0}.dialog-product img{height:280px;min-height:0}.dialog-copy{padding:25px}.dialog-copy .catalog-title{font-size:27px}}
  @media(prefers-reduced-motion:reduce){.catalog-card,.catalog-media img,.catalog-view{animation:none;transition:none}}
</style>

<style is:global>
  .dialog-media{position:relative;background:#edf2ee;overflow:hidden}
  .dialog-media img{width:100%;height:100%;min-height:500px;object-fit:cover;transition:transform .6s ease}
  .dialog-media:hover img{transform:scale(1.03)}
  .dialog-badges{position:absolute;left:16px;top:16px;display:grid;gap:6px;z-index:1}
  .dialog-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin:0 0 8px}
  .dialog-fav{position:static;width:40px;height:40px;flex-shrink:0;background:#fff;border:1px solid #e5ebe5}
  .dialog-price{font-size:22px;margin:12px 0 18px;font-weight:600}
  .dialog-meta{display:grid;gap:6px;margin-top:18px;padding-top:18px;border-top:1px solid #e8eeea}
  .dialog-meta .catalog-meta{font-size:11px;color:#5f6962;margin:0}
  .dialog-actions{margin-top:24px;display:flex;gap:12px;flex-wrap:wrap}
  .dialog-primary{padding:12px 28px;background:#171a18;color:#fff;border-radius:999px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;transition:transform .2s,box-shadow .2s}
  .dialog-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(23,26,24,.25)}
  .product-dialog{border-radius:18px;overflow:hidden}
  .product-dialog::backdrop{background:rgba(23,26,24,.55);backdrop-filter:blur(6px)}
  .dialog-close{top:14px;right:14px;width:40px;height:40px;font-size:22px;background:rgba(255,255,255,.9);backdrop-filter:blur(4px)}

  @media (max-width: 680px) {
    .product-dialog{width:calc(100% - 16px);max-height:calc(100dvh - 16px);border-radius:14px}
    .dialog-product{grid-template-columns:1fr;min-height:0}
    .dialog-media{height:300px}
    .dialog-media img{min-height:300px;height:300px}
    .dialog-copy{padding:24px 20px}
    .dialog-copy .catalog-title{font-size:26px}
    .dialog-price{font-size:18px}
  }
</style>
