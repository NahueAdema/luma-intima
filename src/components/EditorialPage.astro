---
import Layout from '../layouts/Layout.astro';
import InfoBar from './InfoBar.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { title: string; overline: string; description: string }
const { title, overline, description } = Astro.props;
---
<Layout title={`${title} | Luma Íntima`} description={description}><InfoBar/><Header/><main class="editorial-page"><header class="editorial-hero"><p>{overline}</p><h1>{title}</h1><span>{description}</span><nav><a href="/">Inicio</a><i>/</i><a href="/tienda/">Tienda</a><i>/</i><b>{title}</b></nav><div class="editorial-mark">✳</div></header><div class="editorial-content"><slot/></div></main><Footer/></Layout>
<style>
  .editorial-page{--ink:#171a18;--mint:#afdac6;--paper:#fafaf7;background:var(--paper);color:var(--ink);min-height:60vh}.editorial-hero{position:relative;text-align:center;padding:74px 20px 48px;background:linear-gradient(130deg,#e5f2ea,#fafaf7 65%);overflow:hidden}.editorial-hero>p{font-size:9px;letter-spacing:.24em;color:#65806c;font-weight:600}.editorial-hero h1{font-size:clamp(42px,6vw,68px);font-weight:300;letter-spacing:-.045em;margin:14px 0 9px}.editorial-hero>span{color:#727e75;font-size:12px}.editorial-hero nav{display:flex;justify-content:center;align-items:center;gap:9px;margin-top:25px;font-size:10px;color:#879089}.editorial-hero nav b{color:var(--ink);font-weight:500}.editorial-mark{position:absolute;right:12%;top:25%;font-size:60px;color:#afdac633}.editorial-content{max-width:1000px;margin:0 auto;padding:55px 30px 80px}.editorial-content h2{font-size:22px;font-weight:400;margin:0 0 12px}.editorial-content p{font-size:12px;line-height:1.9;color:#6f7972}.editorial-content a{color:#476650;text-decoration:underline;text-underline-offset:3px}.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:22px 0 42px}.info-card{padding:23px;background:white;border:1px solid #e5ece7}.info-card>span{font-size:18px;color:#77947f}.info-card h2{font-size:15px!important;margin:13px 0 7px!important}.info-card p{margin:0}.faq-list{display:grid;gap:10px;margin-top:26px}.faq-list details{padding:18px 20px;border:1px solid #e2eae4;background:white}.faq-list summary{cursor:pointer;list-style:none;font-size:12px;font-weight:500}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary:after{content:'+';float:right;color:#6d8c74;font-size:17px}.faq-list details[open] summary:after{content:'−'}.faq-list details p{margin:13px 0 0}.guide-steps{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin:28px 0}.guide-step{padding:24px;background:white;border:1px solid #e5ece7}.guide-step b{display:block;color:#6d8c74;font-size:10px;letter-spacing:.14em;margin-bottom:10px}.editorial-cta{display:inline-flex;align-items:center;gap:14px;margin-top:20px;padding:14px 19px;background:#171a18;color:white!important;text-decoration:none!important;font-size:10px;letter-spacing:.12em;text-transform:uppercase}@media(max-width:650px){.editorial-hero{padding:55px 18px 38px}.editorial-mark{right:4%;font-size:42px}.editorial-content{padding:35px 18px 55px}.info-grid,.guide-steps{grid-template-columns:1fr}.info-card{padding:19px}}
  .editorial-content :global(h2){font-size:22px;font-weight:400;margin:0 0 12px}.editorial-content :global(p){font-size:12px;line-height:1.9;color:#6f7972}.editorial-content :global(a){color:#476650;text-underline-offset:3px}.editorial-content :global(.info-grid){display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:22px 0 42px}.editorial-content :global(.info-card){padding:23px;background:white;border:1px solid #e5ece7}.editorial-content :global(.info-card h2){font-size:15px;margin:13px 0 7px}.editorial-content :global(.info-card p){margin:0}.editorial-content :global(.faq-list){display:grid;gap:10px;margin-top:26px}.editorial-content :global(.faq-list details){padding:18px 20px;border:1px solid #e2eae4;background:white}.editorial-content :global(.faq-list summary){cursor:pointer;list-style:none;font-size:12px;font-weight:500}.editorial-content :global(.faq-list summary::-webkit-details-marker){display:none}.editorial-content :global(.faq-list summary:after){content:'+';float:right;color:#6d8c74;font-size:17px}.editorial-content :global(.faq-list details[open] summary:after){content:'−'}.editorial-content :global(.faq-list details p){margin:13px 0 0}.editorial-content :global(.guide-steps){display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin:28px 0}.editorial-content :global(.guide-step){padding:24px;background:white;border:1px solid #e5ece7}.editorial-content :global(.guide-step b){display:block;color:#6d8c74;font-size:10px;letter-spacing:.14em;margin-bottom:10px}.editorial-content :global(.editorial-cta){display:inline-flex;align-items:center;gap:14px;margin-top:20px;padding:14px 19px;background:#171a18;color:white;text-decoration:none;font-size:10px;letter-spacing:.12em;text-transform:uppercase}@media(max-width:650px){.editorial-content :global(.info-grid),.editorial-content :global(.guide-steps){grid-template-columns:1fr}.editorial-content :global(.info-card){padding:19px}}
</style>
