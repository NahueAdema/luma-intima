---
const slides = [
  {
    image: '/banner%20luma.png',
    subtitle: 'LENCERÍA & SEXSHOP',
    title: 'Todo lo que te hace sentir bien',
    button: 'VER PRODUCTOS',
    href: '/tienda',
  },
  {
    image: 'https://images.unsplash.com/photo-1596755389378-c31d21fd1273?q=80&w=1976&auto=format&fit=crop',
    subtitle: 'NOVEDADES',
    title: 'Nuevas piezas para vos',
    button: 'VER NOVEDADES',
    href: '/tienda/novedades/',
  },
  {
    image: 'https://images.unsplash.com/photo-1535295972055-1c762f4483e5?q=80&w=1974&auto=format&fit=crop',
    subtitle: 'PROMOCIONES',
    title: 'Ofertas que te enamoran',
    button: 'VER PROMOCIONES',
    href: '/tienda/promociones/',
  },
];
---
<section class="hero" aria-label="Banner principal">
  <div class="hero-container">
    {slides.map((slide, index) => (
      <article class={`hero-slide ${index === 0 ? 'is-active' : ''}`} data-index={index} aria-hidden={index === 0 ? 'false' : 'true'}>
        <div class="hero-right">
          <img src={slide.image} alt={slide.title} class="hero-image" loading={index === 0 ? 'eager' : 'lazy'} />
        </div>
        <div class="hero-left">
          <span class="hero-subtitle">{slide.subtitle}</span>
          <h1 class="hero-title">{slide.title}</h1>
          <div class="hero-decoration">
            <span class="decoration-line"></span>
            <i data-lucide="heart" class="decoration-heart"></i>
            <span class="decoration-line"></span>
          </div>
          <a href={slide.href} class="hero-button">
            {slide.button}
            <i data-lucide="arrow-right" class="button-arrow"></i>
          </a>
        </div>
      </article>
    ))}

    <button class="hero-arrow hero-arrow-left" aria-label="Anterior" type="button">
      <i data-lucide="chevron-left" class="arrow-icon"></i>
    </button>
    <button class="hero-arrow hero-arrow-right" aria-label="Siguiente" type="button">
      <i data-lucide="chevron-right" class="arrow-icon"></i>
    </button>

    <div class="hero-indicators" role="tablist" aria-label="Slides del banner">
      {slides.map((_, index) => (
        <button class={`indicator ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Ir al slide ${index + 1}`} type="button"></button>
      ))}
    </div>
  </div>
</section>

<script>
  const slides = [...document.querySelectorAll('.hero-slide')];
  const indicators = [...document.querySelectorAll('.hero-indicators .indicator')];
  const prev = document.querySelector('.hero-arrow-left');
  const next = document.querySelector('.hero-arrow-right');
  let current = 0;
  let timer;

  function goTo(index: number) {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => {
      const active = i === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
    });
    indicators.forEach((indicator, i) => indicator.classList.toggle('active', i === current));
    // re-create lucide icons for newly shown slide (they are already rendered)
  }

  function startAutoplay() {
    stopAutoplay();
    timer = window.setInterval(() => goTo(current + 1), 6000);
  }
  function stopAutoplay() {
    if (timer) window.clearInterval(timer);
  }

  prev?.addEventListener('click', () => { goTo(current - 1); startAutoplay(); });
  next?.addEventListener('click', () => { goTo(current + 1); startAutoplay(); });
  indicators.forEach((indicator) => {
    indicator.addEventListener('click', () => { goTo(Number(indicator.dataset.index)); startAutoplay(); });
  });

  const hero = document.querySelector<HTMLElement>('.hero');
  hero?.addEventListener('mouseenter', stopAutoplay);
  hero?.addEventListener('mouseleave', startAutoplay);

  startAutoplay();
</script>

<style>
  .hero {
    width: 100%;
    background-color: #e9ded1;
    padding: 0;
  }

  .hero-container {
    max-width: 100%;
    position: relative;
    height: 500px;
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
    z-index: 0;
  }

  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    height: 100%;
    width: 100%;
    max-width: none;
    margin: 0 auto;
    isolation: isolate;
  }

  .hero-left {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    width: 57%;
    height: 100%;
    padding: 4rem clamp(5rem, calc((100vw - 1600px) / 2 + 5rem), 10rem);
    gap: 1.5rem;
    background: linear-gradient(90deg, rgba(233, 222, 209, 0.98) 0%, rgba(233, 222, 209, 0.92) 64%, rgba(233, 222, 209, 0.58) 84%, rgba(233, 222, 209, 0) 100%);
  }

  .hero-left > * {
    position: relative;
    z-index: 1;
  }

  .hero-subtitle {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-soft-black);
    font-weight: 400;
  }

  .hero-title {
    font-family: 'Dancing Script', cursive;
    font-size: 64px;
    font-weight: 600;
    color: var(--color-soft-black);
    line-height: 1.15;
    max-width: 420px;
    text-shadow: 0 2px 18px rgba(175, 218, 198, 0.35);
  }

  .hero-decoration {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 0.5rem;
  }

  .decoration-line {
    width: 40px;
    height: 1px;
    background-color: var(--color-soft-black);
  }

  .decoration-heart {
    width: 14px;
    height: 14px;
    color: var(--color-soft-black);
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--color-mint-primary), #8fd0b5);
    color: var(--color-soft-black);
    padding: 14px 38px;
    border-radius: 50px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    margin-top: 1rem;
    transition: all 0.3s ease;
    align-self: flex-start;
    box-shadow: 0 8px 24px rgba(175, 218, 198, 0.55);
    position: relative;
    overflow: hidden;
  }

  .hero-button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.55) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .hero-button:hover::after {
    transform: translateX(100%);
  }

  .hero-button:hover {
    background-color: #9fcdb8;
    transform: translateX(4px);
    box-shadow: 0 12px 30px rgba(175, 218, 198, 0.7);
  }

  .button-arrow {
    width: 16px;
    height: 16px;
  }

  .hero-right {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    filter: saturate(1.05) brightness(1.02);
    transition: transform 6s ease;
  }

  .hero-slide.is-active .hero-image {
    transform: scale(1.06);
  }

  .hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .hero-arrow:hover {
    background-color: #ffffff;
    transform: translateY(-50%) scale(1.05);
  }

  .hero-arrow-left {
    left: 2rem;
  }

  .hero-arrow-right {
    right: 2rem;
  }

  .arrow-icon {
    width: 20px;
    height: 20px;
    color: var(--color-soft-black);
  }

  .hero-indicators {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(23, 26, 24, 0.3);
    transition: all 0.3s ease;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .indicator.active {
    background-color: var(--color-soft-black);
    width: 28px;
    border-radius: 6px;
  }

  @media (max-width: 968px) {
    .hero-container {
      height: 420px;
    }
    .hero-left {
      padding: 2rem 3rem;
    }
    .hero-title {
      font-size: 42px;
    }
    .hero-arrow {
      width: 38px;
      height: 38px;
    }
    .hero-arrow-left {
      left: 1rem;
    }
    .hero-arrow-right {
      right: 1rem;
    }
  }

  @media (max-width: 768px) {
    .hero-container {
      height: 470px;
    }
    .hero-left {
      width: min(100%, 650px);
      padding: 2.5rem 2rem;
      background: linear-gradient(90deg, rgba(233, 222, 209, 0.96) 0%, rgba(233, 222, 209, 0.86) 62%, rgba(233, 222, 209, 0.3) 100%);
    }
    .hero-right {
      height: 100%;
    }
    .hero-title {
      font-size: 36px;
      max-width: 100%;
    }
    .hero-arrow {
      display: none;
    }
    .hero-indicators {
      bottom: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      height: 430px;
    }
    .hero-left {
      padding: 2rem 1.5rem;
    }
    .hero-title {
      font-size: 32px;
    }
    .hero-arrow { display: none; }
  }
</style>