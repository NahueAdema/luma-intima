---
import Layout from '../layouts/Layout.astro';
import InfoBar from '../components/InfoBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <InfoBar />
  <Header />
<section class="contacto">
  <div class="contacto-container">
    <div class="contacto-header">
      <h1 class="contacto-title">Contacto</h1>
      <p class="contacto-subtitle">Estamos para ayudarte. Contáctanos de la manera que prefieras</p>
    </div>

    <div class="contacto-content">
      <div class="contacto-info">
        <div class="info-card">
          <div class="info-icon-wrapper">
            <i data-lucide="mail" class="info-icon"></i>
          </div>
          <div class="info-text">
            <h3 class="info-title">Email</h3>
            <p class="info-detail">info@lumaintima.com</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon-wrapper">
            <i data-lucide="phone" class="info-icon"></i>
          </div>
          <div class="info-text">
            <h3 class="info-title">Teléfono</h3>
            <p class="info-detail">+54 11 XXXX XXXX</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon-wrapper">
            <i data-lucide="instagram" class="info-icon"></i>
          </div>
          <div class="info-text">
            <h3 class="info-title">Instagram</h3>
            <p class="info-detail">@lumaintima</p>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon-wrapper">
            <i data-lucide="clock" class="info-icon"></i>
          </div>
          <div class="info-text">
            <h3 class="info-title">Horarios de atención</h3>
            <p class="info-detail">Lunes a Viernes<br />9:00 - 18:00 hs</p>
          </div>
        </div>
      </div>

      <div class="contacto-form-wrapper">
        <form class="contacto-form" name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />
          
          <div class="form-group">
            <label for="nombre" class="form-label">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" class="form-input" required />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-input" required />
          </div>

          <div class="form-group">
            <label for="telefono" class="form-label">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" class="form-input" />
          </div>

          <div class="form-group">
            <label for="asunto" class="form-label">Asunto</label>
            <input type="text" id="asunto" name="asunto" class="form-input" required />
          </div>

          <div class="form-group form-group-full">
            <label for="mensaje" class="form-label">Mensaje</label>
            <textarea id="mensaje" name="mensaje" class="form-textarea" rows="6" required></textarea>
          </div>

          <button type="submit" class="form-button">
            ENVIAR MENSAJE
            <i data-lucide="send" class="form-button-icon"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
  <Footer />
</Layout>

<style>
  .contacto {
    background-color: var(--color-warm-white);
    padding: 4rem 0;
  }

  .contacto-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .contacto-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contacto-title {
    font-size: 42px;
    font-weight: 400;
    color: var(--color-soft-black);
    font-family: 'Montserrat', sans-serif;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .contacto-subtitle {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-neutral-gray);
    font-weight: 400;
  }

  .contacto-content {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }

  .contacto-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background-color: var(--color-mint-light);
    border-radius: 8px;
  }

  .info-icon-wrapper {
    width: 44px;
    height: 44px;
    background-color: var(--color-mint-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-icon {
    width: 22px;
    height: 22px;
    color: var(--color-soft-black);
  }

  .info-text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .info-title {
    font-size: 13px;
    color: var(--color-soft-black);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .info-detail {
    font-size: 12px;
    color: var(--color-soft-black);
    line-height: 1.6;
  }

  .contacto-form-wrapper {
    background-color: #ffffff;
    padding: 2.5rem;
    border: 1px solid rgba(192, 229, 212, 0.5);
  }

  .contacto-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group-full {
    grid-column: 1 / -1;
  }

  .form-label {
    font-size: 11px;
    color: var(--color-soft-black);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .form-input,
  .form-textarea {
    padding: 10px 14px;
    border: 1px solid #e0e0e0;
    font-size: 13px;
    font-family: 'Montserrat', sans-serif;
    color: var(--color-soft-black);
    background-color: #ffffff;
    transition: border-color 0.3s ease;
    outline: none;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-mint-primary);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-button {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    background-color: var(--color-mint-primary);
    color: var(--color-soft-black);
    padding: 12px 32px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    transition: all 0.3s ease;
    justify-self: start;
    margin-top: 0.5rem;
  }

  .form-button:hover {
    background-color: #9fcdb8;
  }

  .form-button-icon {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 968px) {
    .contacto-container {
      padding: 0 1.5rem;
    }
    
    .contacto-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .contacto-form-wrapper {
      padding: 2rem;
    }
  }

  @media (max-width: 640px) {
    .contacto {
      padding: 3rem 0;
    }
    
    .contacto-container {
      padding: 0 1rem;
    }
    
    .contacto-title {
      font-size: 32px;
    }
    
    .contacto-form {
      grid-template-columns: 1fr;
    }
    
    .contacto-form-wrapper {
      padding: 1.5rem;
    }
  }
</style>